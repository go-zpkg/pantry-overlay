# github.com/msgpack/msgpack-python — msgpack: the MessagePack serializer for
# Python, with its C extension.
#
# ⛔ WRITTEN FROM THE SDIST'S OWN FILES (go-zpkg/packages#440), as a run-time
# dependency of borgbackup.org.

summary = "msgpack: MessagePack serializer for Python"

# pyproject.toml:8 `license = "Apache-2.0"`; the sdist's COPYING is headed
# "Licensed under the Apache License, Version 2.0".
license = "Apache-2.0"

# ⛔ HELD AT 1.2.1 ON PURPOSE. borgbackup 1.4.5 declares
# `msgpack >=1.0.3, <=1.2.1` (its pyproject.toml:38) and says any other version
# is unsupported by its developers (:33-37). PyPI has 1.2.2, 1.2.3 and 1.2.4
# beyond it, so they are ignored here rather than offered to a consumer that
# would get a combination borg does not support. Raise the ignore with borg.
#
# The tags of the repository are the source, and they carry a `v` prefix
# (`zpkb versions` printed v1.2.1, v1.2.0, v1.1.2 as the raw tags).
versions {
  github = "msgpack/msgpack-python/tags"
  strip  = "/^v/"
  ignore = [
    "/^1\\.2\\.[2-9]$/",
    "/^1\\.2\\.[1-9][0-9]+$/",
    "/^1\\.[3-9]/",
    "/^[2-9]\\./",
  ]
}

dependencies = {
  "python.org" = "^3.10"
}

distributable {
  url              = "https://files.pythonhosted.org/packages/source/m/msgpack/msgpack-{{version.raw}}.tar.gz"
  strip-components = 1

  # Fetched with `zpkb sourcepin`, and the same as the sha256 PyPI's simple index
  # (pypi.org/simple/msgpack/) records for the sdist.
  sha256 = {
    "1.2.1" = "04c721c2c7448767e9e3f2520a475663d8ee0f09c31890f6d2bd70fd636a9647"
  }
}

build {
  dependencies = {
    "pypa.io/setuptools" = "*"
  }

  script = [
    {
      # pyproject.toml:1-3 requires ["setuptools >= 78.1.1"], backend
      # setuptools.build_meta; the version is read from msgpack.__version__
      # (:35-36). setup.py:17-26 builds the msgpack._cmsgpack extension from
      # msgpack/_cmsgpack.c, which the sdist ships beside the .pyx files, so
      # Cython is not needed; MSGPACK_PUREPYTHON is left unset so the extension
      # is built. The compiler is the system's.
      run = <<EOT
set -eu
python3 -m pip install --no-build-isolation --no-index --no-deps --no-compile --prefix "{{prefix}}" .
EOT
    },
  ]
}

runtime {
  env = {
    PYTHONPATH = "{{prefix}}/lib/python{{deps.python.org.version.major}}.{{deps.python.org.version.minor}}/site-packages:$PYTHONPATH"
  }
}

test {
  script = [
    {
      run = <<EOT
set -eu
PYVER=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
cat > probe.py <<'PYEOF'
import importlib.metadata, msgpack
assert importlib.metadata.version("msgpack") == "{{version.raw}}"
assert msgpack.unpackb(msgpack.packb({"a": [1, 2]})) == {"a": [1, 2]}
from msgpack import _cmsgpack
print(msgpack.__file__)
PYEOF
PYTHONPATH="{{prefix}}/lib/python$PYVER/site-packages" python3 probe.py > where.txt
grep "{{prefix}}" where.txt >/dev/null || { echo "msgpack was not imported from this prefix" >&2; cat where.txt >&2; exit 1; }
EOT
    },
  ]
}

provenance {
  read = [
    "pyproject.toml",   # :1-3 build-system; :8 license Apache-2.0; :13 requires-python >=3.10; :22 no dependencies; :35-36 dynamic version
    "setup.py",         # :17-26 the _cmsgpack extension from msgpack/_cmsgpack.c, unless MSGPACK_PUREPYTHON
    "msgpack/_cmsgpack.c", # :1 "Generated by Cython 3.2.5"
    "COPYING",          # Apache License 2.0
    "msgpack/__init__.py", # :8 __version__ = "1.2.1"
  ]

  consulted = [
    "pypi.org/simple/msgpack/", # the second witness for the digest, and the list of releases past 1.2.1
    "borgbackup 1.4.5 pyproject.toml", # :33-38 the msgpack range
  ]

  note = <<EOT
NOT BUILT. Written from the project's own files; neither the build nor the
test block has been run, on either platform.

⛔ NOT SIGNED. The digest is witnessed by PyPI's simple index and by the bytes
`zpkb sourcepin` fetched, which agree.

The `ignore` list holds the line at 1.2.1: `zpkb versions` resolved 1.2.1, 1.2.0,
1.1.2 newest first, with 1.2.2 to 1.2.4 excluded.

The sdist's msgpack/_cmsgpack.c starts with "Generated by Cython 3.2.5", so no
Cython is needed to build it.
EOT
}
