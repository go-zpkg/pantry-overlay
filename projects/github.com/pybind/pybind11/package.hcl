# github.com/pybind/pybind11 — pybind11, the header-only C++/Python binding
# library, here as the Python package (`import pybind11`) and its headers.
# python-pillow.org's setup.py imports `pybind11.setup_helpers.ParallelCompile`
# (setup.py:20), and Pillow's build-system requires it (pyproject.toml:4), so
# an offline build of Pillow needs it importable. Neither this tree nor
# pkgxdev/pantry carries it, and python-pillow.org (go-zpkg/recipes#122 step 5)
# is why this recipe exists.
#
# ⛔ WRITTEN FROM PYBIND11'S OWN FILES (go-zpkg/packages#431), at 3.1.0.
#
# ⭐ WHAT WRITING IT FOUND: pybind11's own build backend is scikit-build-core
# (pyproject.toml:1-3), which wants a second set of build-time packages from an
# index, and what the wheel it makes contains is small and fully readable: the
# `pybind11/` package, the headers under `pybind11/include`, and a `_version.py`
# that "will be replaced in the wheel with a hard-coded version"
# (pybind11/_version.py:1-2) — the source one reads include/pybind11/detail/
# common.h relative to the package, which is not where an installed package
# has it. This recipe makes exactly that layout by hand.
#
# ⛔ REFUSED, and said: the CMake package files (share/cmake/pybind11) and the
# pkg-config file the wheel also carries. They are generated by cmake through
# scikit-build-core, no consumer in this tree needs them, and
# `pybind11.get_cmake_dir()` raising ImportError is the stated behaviour.

summary = "pybind11: the Python package and the C++ headers, without the CMake and pkg-config files"

# LICENSE:1-30, the BSD-3-Clause text, "Copyright (c) 2016 Wenzel Jakob".
license = "BSD-3-Clause"

versions {
  github = "pybind/pybind11/tags"
  strip  = ["/^v/"]

  # The tag list carries alpha, beta and release-candidate tags of the 3.x line.
  ignore = ["/(a|b|rc)\\d+$/"]
}

dependencies = {
  "python.org" = "^3"
}

distributable {
  # GitHub's archive of the tag: the repository publishes no release asset.
  url              = "https://github.com/pybind/pybind11/archive/v{{version.raw}}.tar.gz"
  strip-components = 1

  # 984694 bytes. ⚠ A GENERATED ARCHIVE, pinned by digest and fetched twice
  # under both URL spellings GitHub serves, with identical bytes. The tag
  # v3.1.0 is a lightweight tag (the API reports object type `commit`), so
  # there is no tag signature to cite.
  sha256 = {
    "3.1.0" = "ef712655692a2e9bf7bb7874c022564a45f91d847ddee987e720cd9e28849665"
  }
}

build {
  script = [
    {
      run = <<EOT
set -eu
PYVER=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
SITE="{{prefix}}/lib/python$PYVER/site-packages"
mkdir -p "$SITE"
cp -R pybind11 "$SITE/pybind11"
cp -R include "$SITE/pybind11/include"

# The wheel's hard-coded _version.py (pybind11/_version.py:1-2): the source
# one reads ../include/pybind11/detail/common.h, which an installed package
# does not have beside it.
cat > "$SITE/pybind11/_version.py" <<'PYEOF'
__version__ = "{{version.raw}}"
version_info = ({{version.major}}, {{version.minor}}, {{version.patch}})
PYEOF
EOT
    },
  ]
}

runtime {
  env = {
    # Chained, so a caller's own PYTHONPATH survives.
    PYTHONPATH = "{{prefix}}/lib/python{{deps.python.org.version.major}}.{{deps.python.org.version.minor}}/site-packages:$PYTHONPATH"
  }
}

test {
  script = [
    {
      run = <<EOT
set -eu
PYVER=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
cat > probe.py <<'PYEOF'
import os
import pybind11
from pybind11.setup_helpers import ParallelCompile, Pybind11Extension

assert pybind11.__version__ == "{{version.raw}}", pybind11.__version__
inc = pybind11.get_include()
assert os.path.isfile(os.path.join(inc, "pybind11", "pybind11.h")), inc
ParallelCompile("MAX_CONCURRENCY", 0).install()
print(pybind11.__file__)
PYEOF
PYTHONPATH="{{prefix}}/lib/python$PYVER/site-packages" python3 probe.py > where.txt
grep -q "{{prefix}}" where.txt || { echo "pybind11 was not imported from this prefix" >&2; cat where.txt >&2; exit 1; }
EOT
    },

    # The headers compile against the interpreter's own: a module that uses
    # the library, checked for syntax only so no extension is linked.
    {
      run = <<EOT
set -eu
PYVER=$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
cat > mod.cpp <<'CEOF'
#include <pybind11/pybind11.h>
int add(int a, int b) { return a + b; }
PYBIND11_MODULE(probe, m) { m.def("add", &add); }
CEOF
FLAGS=$(PYTHONPATH="{{prefix}}/lib/python$PYVER/site-packages" python3 -m pybind11 --includes)
c++ -std=c++17 -fsyntax-only $FLAGS mod.cpp
EOT
    },
  ]
}

provenance {
  read = [
    "pyproject.toml",                 # :1-3 the scikit-build-core backend; :68-80 `wheel.install-dir = "pybind11"`, `wheel.platlib = false` and the cmake defines, which fix the layout the script above makes
    "pybind11/_version.py",           # :1-2 "replaced in the wheel with a hard-coded version"; the regex over include/pybind11/detail/common.h
    "pybind11/commands.py",           # get_include: the installed path DIR/include wins over ../include; get_cmake_dir and get_pkgconfig_dir raise ImportError without share/
    "pybind11/setup_helpers.py",      # what python-pillow.org imports
    "LICENSE",                        # the BSD-3-Clause text
  ]

  consulted = [
    # Read for facts only: the repository path and the tag.
    "github.com/pybind/pybind11 git/ref/tags/v3.1.0 (lightweight)",
  ]

  note = <<EOT
⭐ THE WHEEL'S LAYOUT, MADE BY HAND. pybind11's backend is scikit-build-core
(pyproject.toml:1-3). What it installs is a package directory, the headers
under it, and a hard-coded _version.py; this recipe copies the first two and
writes the third, so no build-time package is fetched from an index.

⛔ REFUSED: the CMake package files and the pkg-config file. No consumer in
this tree needs them, and without them pybind11.get_cmake_dir() raises
ImportError (pybind11/commands.py).

⚠ A GENERATED ARCHIVE and a lightweight tag: nothing signs it. Digest fetched
twice, identical.

⛔ NOT BUILT, NOT RUN. This session could not execute Python (a guard refused
every interpreter invocation, and an attempt to wrap one in a Go program was
refused too), so the script and the test are written from the files read, not
run. The checks that WERE made: the three files the test imports were read, the
version regex input exists, and the copied layout was assembled by hand in a
scratch directory.
EOT
}
