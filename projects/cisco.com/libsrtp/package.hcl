# libsrtp — Cisco's implementation of the Secure Real-time Transport Protocol
# (RFC 3711), as libsrtp2.
#
# ⛔ WRITTEN FROM LIBSRTP'S OWN FILES at 2.8.1, step 1 of go-zpkg/packages#440.
# It was a fragment declaring one dependency (openssl ^3) and nothing else:
# no source, no build, and no statement of whether openssl is USED.

summary = "Secure Real-time Transport Protocol (SRTP) library, libsrtp2"

# LICENSE opens "Copyright (c) 2001-2017 Cisco Systems, Inc. All rights
# reserved. Redistribution and use in source and binary forms …" — the
# three-clause BSD text; homebrew-core records the same.
license = "BSD-3-Clause"

# The crypto library it links at run time (--enable-openssl below), so it is a
# runtime dependency and not only a build input. `^3` as the fragment had it:
# configure.ac:245 asks for libcrypto >= 1.1.0 and this registry publishes no
# openssl 1.x.
dependencies = {
  "openssl.org" = "^3"
}

versions {
  github = "cisco/libsrtp"

  # ⛔ THE TWO-PART AND ONE-PART TAGS ARE IGNORED. The repository carries
  # `v2`, `v2.8`, `v2.7`, … beside `v2.8.1`, and `zpkb versions` lists them as
  # versions "2", "2.8" and so on. They are MOVING aliases for the latest
  # patch, so a digest pinned against one would go stale the next release.
  # Only `vMAJOR.MINOR.PATCH` tags are releases.
  ignore = [
    "/beta|alpha|rc/",
    "/^v\\d+(\\.\\d+)?$/",
  ]
}

distributable {
  # ⛔⛔ A GITHUB-GENERATED ARCHIVE, AND IT IS THE ONLY ONE THERE IS. The
  # lz4 recipe takes the stored release asset because lz4 uploads one; this
  # project does not: all 18 releases listed by the API (v1.5.0 … v2.8.1)
  # carry ZERO assets, and the tag is a lightweight one (ref → commit
  # 6ff02afa8d2dc3f2e8896af391d137c1c66ff6fa, no tag object, so no signed
  # tag either). So `archive/refs/tags/` is the only distributable, and the
  # fragility lz4's note describes is LATENT here: a GitHub-side change to
  # how it compresses invalidates the digest without anybody touching the
  # project. Recorded rather than hidden.
  url              = "https://github.com/cisco/libsrtp/archive/refs/tags/v{{version.raw}}.tar.gz"
  strip-components = 1

  # 2.8.1 — 647 097 bytes, fetched with `zpkb sourcepin`. No signature and no
  # published checksum exist (no release assets, unsigned tag), so the second
  # witness is a THIRD PARTY's: homebrew-core's Formula/s/srtp.rb records
  # `url …/archive/refs/tags/v2.8.1.tar.gz` and
  # sha256 ef5569220749529d778013aae1178391d972570a2b4f7288dda22effa875b07c —
  # byte-identical to what sourcepin computed.
  #
  # ⛔ WHAT THAT AGREEMENT IS WORTH: two parties fetched the same generated
  # bytes, so it shows the archive was stable between two observations and
  # that the digest is not a transcription error; it does NOT show the bytes
  # are the author's. Stated as weaker than the Apache/Xiph recipes' chain.
  #
  # 2.8.2 — 648 560 bytes, the newest tag `versions` resolves (CI's
  # --check-newest-pinned requires it). ⛔ WEAKER THAN 2.8.1: it is an annotated
  # tag (tagger Pascal Bühler, 2026-11-17, "2.8.2 Release") but UNSIGNED
  # (GitHub verification: "unsigned"), there is NO GitHub release for it, and
  # homebrew-core is still on 2.8.1, so there is no third-party digest. The
  # digest below was computed twice (`zpkb sourcepin` and an independent
  # curl + shasum, both 02e8326e…), which shows the generated bytes were stable
  # across two fetches and nothing more. configure.ac differs from 2.8.1 in the
  # AC_INIT version only; CHANGES lists #845 (a bounds check before RTP
  # unprotect) and #829 (missing exports in srtp.def).
  sha256 = {
    "2.8.1" = "ef5569220749529d778013aae1178391d972570a2b4f7288dda22effa875b07c"
    "2.8.2" = "02e8326e12381e27a205ded888a803c6ff55ec7be170cd5e5506251f731fee92"
  }
}

build {
  dependencies = {
    # configure.ac:204-205 PKG_PROG_PKG_CONFIG and :244-247 PKG_CHECK_MODULES
    # for libcrypto. WITHOUT pkg-config the `else` branch (:248-251) runs
    # AC_CHECK_LIB([z], …) and links whatever libz the host has — a silent,
    # host-dependent dependency — so pkg-config is a declared build input.
    "freedesktop.org/pkg-config" = "*"
  }

  env {
    ARGS = [
      "--prefix={{prefix}}",
      "--libdir={{prefix}}/lib",

      # ⛔ THE CRYPTO ENGINE, CHOSEN RATHER THAN DEFAULTED. configure.ac
      # :207-217 gives three outcomes — openssl, nss, or the built-in
      # (:331-334, aes_icm.o / hmac.o+sha1.o) — and the DEFAULT is the
      # built-in, `enable_openssl=no`. The fragment declared openssl and
      # never said to use it, so it would have been staged and unused. It is
      # used here: OpenSSL is what provides AES-GCM, which `AC_DEFINE([GCM])`
      # turns on only for openssl or nss (:262, :323).
      "--enable-openssl",
      "--with-openssl-dir={{deps.openssl.org.prefix}}",

      # The other options of the same family, named off. `--enable-nss` is
      # tested only in the `elif` AFTER openssl (:278), so it would be
      # ignored anyway; stated so a later reader need not work that out.
      "--disable-nss",
      # :269-277 — `kdf_srtp` is an OpenSSL 3.x KDF entry point; the default
      # is no and the SRTP KDF stays libsrtp's own.
      "--disable-openssl-kdf",

      # :341-353 — pcap is only for the test/rtp_decoder tool and is probed
      # with AC_CHECK_LIB, i.e. linked if the host happens to have it.
      "--disable-pcap",

      # :196-202 debug logging in all modules, :356-362 logging to stdout and
      # :365-376 logging to a file: all default off, named so the output is
      # the library's normal one.
      "--disable-debug-logging",
      "--disable-log-stdout",
    ]
  }

  # ⛔ `make` AND `make install` ARE NOT ENOUGH. Makefile.in:43 is `all: test`,
  # which builds libsrtp2.a plus every test program, and :288-295 installs the
  # SHARED library only `if [ -f libsrtp2.$(SHAREDLIBSUFFIX) ]` — a file that
  # only the `shared_library` target (:172) makes. A plain `make install` would
  # ship a static-only libsrtp2 and say nothing. Both are built and installed.
  script = <<EOT
./configure $ARGS
make --jobs {{ hw.concurrency }} libsrtp2.a
make shared_library
make install
EOT
}

test {
  dependencies = {
    "gnu.org/gcc"                = "*"
    "freedesktop.org/pkg-config" = "*"
  }

  script = [
    # The installed layout is Makefile.in:280-297: headers under include/srtp2/.
    "test -f {{prefix}}/include/srtp2/srtp.h",
    "test -f {{prefix}}/lib/libsrtp2.a",
    "pkg-config --exists libsrtp2",
    "pkg-config --modversion libsrtp2 | grep {{version.raw}}",
    {
      fixture = {
        content  = <<EOT
#include <stdio.h>
#include <string.h>
#include <srtp2/srtp.h>

int main(void) {
  if (srtp_init() != srtp_err_status_ok) {
    puts("srtp_init failed");
    return 1;
  }

  /* AES-GCM exists only when configure.ac:262 defined GCM, i.e. only when
     OpenSSL (or NSS) was compiled in. A session created with a GCM policy
     therefore witnesses that --enable-openssl took effect and the default
     built-in engine was not used. */
  srtp_policy_t policy;
  memset(&policy, 0, sizeof policy);
  srtp_crypto_policy_set_aes_gcm_128_16_auth(&policy.rtp);
  srtp_crypto_policy_set_aes_gcm_128_16_auth(&policy.rtcp);
  unsigned char key[28] = {0};
  policy.ssrc.type = ssrc_any_inbound;
  policy.key = key;
  policy.next = NULL;

  srtp_t session;
  if (srtp_create(&session, &policy) != srtp_err_status_ok) {
    puts("could not create a GCM session: libsrtp was built without OpenSSL");
    return 1;
  }
  srtp_dealloc(session);
  srtp_shutdown();
  printf("%s\n", srtp_get_version_string());
  return 0;
}
EOT
        extname = "c"
      }
      run = "gcc $FIXTURE -o srtpcheck $(pkg-config --cflags --libs libsrtp2)"
    },
    "./srtpcheck",
  ]
}

provenance {
  read = [
    "configure.ac",  # :2 AC_INIT 2.8.1; :195-202 --enable-debug-logging; :204-205 pkg-config; :207-217 --enable-openssl / --enable-nss default no; :219-277 openssl branch, :244-251 pkg-config vs the AC_CHECK_LIB libz fallback, :262 GCM, :268-277 --enable-openssl-kdf; :278-330 nss branch; :331-334 the built-in engine; :341-353 --disable-pcap; :356-376 log-stdout / log-file
    "Makefile.in",   # :43 all: test; :161-172 libsrtp2.a and shared_library; :108-125 SHAREDLIBVERSION and the per-OS suffixes; :279-297 install, shared library only if built
    "README.md",
    "LICENSE",       # opens with Cisco's three-clause BSD notice
  ]

  consulted = [
    "homebrew-core Formula/s/srtp.rb",  # the digest corroboration; its url is the generated archive
    "the cisco.com/libsrtp fragment this replaces",
  ]

  note = <<EOT
Autotools, from the archive's checked-in `configure` (the tag archive carries
configure, Makefile.in and config_in.h; no autoconf is needed, so none is
declared). The CMake and Meson build files also exist; configure.ac is the
one read.

Not run: this recipe was not built on a builder at the time it was written.
The shape of the OpenSSL probe was read, not exercised — in particular
configure.ac:223-241 expects libcrypto.pc under <openssl>/lib/pkgconfig, and
a lib64 layout would fall to the `-d lib` branch and fail with "Invalid
OpenSSL location".

macOS: Makefile.in:122-123 passes `-install_name $(libdir)/$@`, an absolute
install_name, which the factory's fix-machos stage owns — as for lz4.

No signature exists for this project's releases: the 18 GitHub releases carry
no assets and the tag is lightweight. The only second witness is
homebrew-core's recorded digest.
EOT
}
